# Local-only / not for repo
.mcp.json
*.pen
*.claude
# Agent skills are committed: real files in .agents/skills/ (managed by the
# `skills` CLI, pinned in skills-lock.json) and the symlinks to them in
# .claude/skills/. Other .claude/ contents (e.g. settings.local.json) stay local.
!.claude/
.claude/*
!.claude/skills/
*.devcontainer
.impeccable.md

# Vercel
.vercel

# Prisma 7 generated client (regenerate with `pnpm db:generate`)
packages/db/generated/

# Scratch / one-off files that keep landing at the repo root
commit-*.txt
commit-message.txt
lint.txt
updates.txt
enhancement.txt
proposal.txt
PROPOSAL.txt
*.scratch.*
.playwright-mcp/
*.pdf
