{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./next": "./src/next.ts",
    "./permissions": "./src/permissions.ts",
    "./keys": "./src/keys.ts"
  },
  "scripts": {
    "create-admin": "dotenv -e ../../.env.local -- tsx scripts/create-admin.ts",
    "gen:schema": "npx @better-auth/cli@latest generate --config ./src/server.ts --output ../db/prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/types": "workspace:*",
    "@t3-oss/env-core": "^0.13.0",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "dotenv-cli": "^11.0.0",
    "next": "catalog:",
    "react": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  }
}
